@model DiscussionBoard.Models.DiscussionThread

<div class="card shadow-sm mb-3">
    <div class="card-body">
        <h4 class="card-title">
            <a asp-page="/Discussions/Details" asp-route-id="@Model.Id" class="text-decoration-none text-dark fw-semibold">
                @Model.Title
            </a>
        </h4>
        <p class="card-text text-secondary text-truncate">@Model.Content</p>
        <div class="d-flex justify-content-between align-items-center text-muted small mt-3">
            <div>
                Posted on @Model.CreatedAt.ToString("g")
            </div>
        </div>
    </div>
</div>



