@page "/Discussion/{id:int}"
@model DiscussionBoard.Pages.Discussions.DetailsModel
@{
    ViewData["Title"] = Model.Thread?.Title ?? "Discussion Thread";
}

<div class="container mt-4">
    @if (Model.Thread == null)
    {
        <div class="alert alert-danger">Thread not found.</div>
    }
    else
    {
        <div class="card mb-4 border-0 shadow-sm">
            <div class="card-body">
                <h1 class="display-6 fw-bold">@Model.Thread.Title</h1>
                <p class="text-muted small">Posted by @(Model.Thread.ApplicationUser?.UserName ?? "Anonymous") on @Model.Thread.CreatedAt.ToString("g")</p>
                <hr />
                <p class="lead" style="white-space: pre-wrap;">@Model.Thread.Content</p>
            </div>
        </div>

        <h3 class="mb-3">Replies</h3>

        @if (Model.Posts == null || !Model.Posts.Any())
        {
            <p class="text-muted bg-light p-4 rounded text-center">No replies yet. Be the first to add a comment!</p>
        }
        else
        {
            <div class="discussion-posts mb-4">
                @foreach (var node in Model.Posts)
                {
                    <partial name="_PostTree" model="node" />
                }
            </div>
        }

        @if (User.Identity?.IsAuthenticated == true)
        {
            <div class="card border-0 shadow-sm mt-4">
                <div class="card-body">
                    <h5 class="card-title fw-bold mb-3">Join the Conversation</h5>
                    <form method="post">
                        <div asp-validation-summary="ModelOnly" class="text-danger"></div>

                        <input type="hidden" name="ThreadId" value="@Model.Thread.Id" />

                        <div class="form-group mb-3">
                            <textarea name="NewPostContent" class="form-control" rows="4" placeholder="Write a respectful reply..."></textarea>
                        </div>

                        <div class="form-group">
                            <button type="submit" class="btn btn-primary">Post Reply</button>
                        </div>
                    </form>
                </div>
            </div>
        }
        else
        {
            <div class="alert alert-info mt-4">
            Please log in
            to participate in this discussion.
                </div>
        }
    }
</div>

