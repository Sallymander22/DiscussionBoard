<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h1 class="display-5 fw-bold">@Model.Forum.Name</h1>
        <p class="text-muted lead">@Model.Forum.Description</p>
    </div>
    @if (User.Identity?.IsAuthenticated == true)
    {
        <a asp-page="/Discussions/Create" asp-route-forumId="@Model.Forum.Id" class="btn btn-primary btn-lg">
            <i class="bi bi-plus-circle me-2"></i>Start New Thread
        </a>
    }
</div>
