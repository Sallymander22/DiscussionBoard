@page
@model DiscussionBoard.Pages.Discussions.CreateModel
@{
    ViewData["Title"] = "Start New Thread";
}

<div class="container mt-4">
    <h1>Start a New Thread</h1>
    <hr />

    <div class="row">
        <div class="col-md-8">
            <form method="post">
                <div asp-validation-summary="ModelOnly" class="text-danger"></div>

                @* This hidden input holds onto the ForumId sent from the previous page *@
                <input type="hidden" asp-for="ForumId" />

                <div class="form-group mb-3">
                    <label asp-for="Input.Title" class="control-label fw-bold">Title</label>
                    <input asp-for="Input.Title" class="form-control" placeholder="Enter a catchy title..." />
                    <span asp-validation-for="Input.Title" class="text-danger"></span>
                </div>

                <div class="form-group mb-3">
                    <label asp-for="Input.Content" class="control-label fw-bold">Content</label>
                    <textarea asp-for="Input.Content" class="form-control" rows="6" placeholder="What would you like to talk about?"></textarea>
                    <span asp-validation-for="Input.Content" class="text-danger"></span>
                </div>

                <div class="form-group">
                    <button type="submit" class="btn btn-primary">Publish Thread</button>
                    <a asp-page="/Forums/Details" asp-route-id="@Model.ForumId" class="btn btn-secondary">Cancel</a>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
