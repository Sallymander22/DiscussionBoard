@page "/Forum/{id:int}"
@model DiscussionBoard.Pages.Forums.DetailsModel
@{
    ViewData["Title"] = Model.Forum?.Name ?? "Forum Details";
}

<div class="container mt-4">
    <nav aria-label="breadcrumb">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a asp-page="/Forums/Index">Forums</a></li>
            <li class="breadcrumb-item active" aria-current="page">@Model.Forum?.Name</li>
        </ol>
    </nav>

    @if (Model.Forum == null)
    {
        <div class="alert alert-danger">Forum not found.</div>
    }
    else
    {
        <div class="d-flex justify-content-between align-items-center mb-4">
            <div>
                <h1 class="display-5 fw-bold">@Model.Forum.Name</h1>
                <p class="text-muted lead">@Model.Forum.Description</p>
            </div>
        </div>

        <h3 class="mb-3">Discussion Threads</h3>

        @if (!Model.Threads.Any())
        {
            <div class="card p-5 text-center bg-light">
                <p class="text-muted m-0">No discussion threads have been created in this forum yet.</p>
            </div>
        }
        else
        {
            <div class="row row-cols-1 g-3">
                @foreach (var thread in Model.Threads)
                {
                    <partial name="_ThreadCard" model="thread" />
                }
            </div>
        }
    }
</div>
